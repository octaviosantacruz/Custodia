{
  "dependencies": {
    "@fontsource-variable/caveat": "^5.3.0",
    "@fontsource-variable/instrument-sans": "5.3.0",
    "@fontsource-variable/jetbrains-mono": "5.3.0",
    "@internationalized/date": "^3.12.4",
    "@tanstack/react-query": "^5.104.0",
    "echarts": "^6.1.0",
    "lucide-react": "^1.31.0",
    "react": "~19.2.9",
    "react-aria-components": "^1.21.1",
    "react-dom": "~19.2.9"
  },
  "devDependencies": {
    "@axe-core/playwright": "^4.13.0",
    "@playwright/test": "^1.62.1",
    "@tanstack/react-query-devtools": "^5.104.0",
    "@testing-library/react": "^16.3.3",
    "@types/react": "^19.2.18",
    "@types/react-dom": "^19.2.4",
    "@vitejs/plugin-react": "^6.0.5",
    "jsdom": "^30.1.1",
    "openapi-typescript": "^7.13.0",
    "oxlint": "^1.88.0",
    "playwright": "^1.62.1",
    "typescript": "^7.0.2",
    "typescript5": "npm:typescript@5.9.3",
    "vite": "^8.2.1"
  },
  "private": true,
  "type": "module",
  "scripts": {
    "dev": "vite",
    "typecheck": "node node_modules/typescript/bin/tsc --noEmit",
    "lint": "oxlint --report-unused-disable-directives src",
    "build": "npm run typecheck && vite build",
    "preview": "vite preview",
    "test:unit": "node scripts/unit-tests.mjs",
    "generate:chains-types": "node scripts/generate-chains-types.mjs",
    "verify:chains-types": "node scripts/verify-chains-types.mjs",
    "verify:styles": "node scripts/verify-style-ownership.mjs && node scripts/verify-style-cascade.mjs",
    "test:e2e": "playwright test",
    "test:e2e:cyberark": "node scripts/e2e-groups.mjs cyberark",
    "test:e2e:netskope": "node scripts/e2e-groups.mjs netskope",
    "test:e2e:cross": "node scripts/e2e-groups.mjs cross",
    "build:demo": "VITE_DEMO=1 npm run build",
    "preview:demo": "npm run build:demo && vite preview"
  },
  "overrides": {
    "openapi-typescript": {
      "typescript": "$typescript"
    }
  },
  "name": "custodia-web",
  "version": "0.2.0"
}
