# ============================================================
# Base de datos
# ============================================================
# Cadena de conexión PostgreSQL completa (usuario, password, host, puerto,
# nombre de la base). Es la única variable obligatoria para levantar el
# backend; sin ella arranca con RuntimeError (backend/app/config.py).
DATABASE_URL=postgresql://user:password@127.0.0.1:5432/cmdb

# ============================================================
# CyberArk Privilege Cloud (PAM): Safes, miembros, cuentas
# ============================================================
# Tenant de CyberArk Identity usado para el login OAuth client_credentials
# (endpoint {CA_IDENTITY_URL}/oauth2/platformtoken).
CA_IDENTITY_URL=https://example.id.cyberark.cloud
# Base de la API de Privilege Cloud (PVWA) desde donde se listan Safes,
# miembros y cuentas.
CA_PVWA_URL=https://example.privilegecloud.cyberark.cloud/PasswordVault
# Client ID del usuario de servicio OAuth autorizado sobre PVWA.
CA_CLIENT_ID=client-id
# Secreto del CA_CLIENT_ID. Dos formas, con prioridad para la primera si
# ambas están presentes:
#   - CA_CLIENT_SECRET: el valor en texto plano (evitar en archivos que se
#     puedan commitear).
#   - CA_SECRET_FILE: ruta a un archivo que contiene solo el secreto (ver
#     .ca_secret, nunca commiteado; en Docker se monta como secret en
#     /run/secrets/ca_secret).
CA_SECRET_FILE=.ca_secret
# Minutos entre corridas automáticas de ingesta PAM programada. 0 deshabilita
# el scheduler. Si es > 0, debe ser >= 5 minutos — ver validación en
# backend/app/config.py y el trade-off de carga contra CyberArk/Identity/SIA
# en docs/operations/ingestion-frequency.md antes de bajar esto en producción.
INGESTION_INTERVAL_MINUTES=1440

# ============================================================
# Escrituras de automatización / scripts técnicos
# ============================================================
# Token compartido requerido en el header X-Access-Token para que scripts o
# automatización (no un usuario humano autenticado por sesión) puedan hacer
# escrituras. Se compara en tiempo constante; nunca commitear un valor real.
# Si queda vacío, esas escrituras quedan deshabilitadas (503).
APP_WRITE_TOKEN=
# actor_id que se registra en la auditoría cuando la escritura se hizo vía
# APP_WRITE_TOKEN en lugar de una sesión de usuario autenticada.
APP_ACTOR_ID=local-admin

# ============================================================
# Fronteras de integración opcionales: Identity Administration y SIA
# ============================================================
# No se hace ninguna llamada a estas fuentes hasta que el contrato de API
# correspondiente esté aprobado (ver docs/architecture/integration-contracts.md).
# Aunque hoy comparten tenant y credenciales con PAM en muchos entornos, se
# configuran de forma independiente A PROPÓSITO: el objetivo es mantener
# Identity Administration y SIA aislados de PAM por source_system (ver
# CLAUDE.md). No colapsar estas variables en las de arriba ni inventar
# endpoints/scopes si el contrato del tenant no está confirmado.

# --- Identity Administration (usuarios y roles vía SCIM) ---
CA_IDENTITY_ADMIN_URL=
CA_IDENTITY_ADMIN_TOKEN_URL=
CA_IDENTITY_ADMIN_CLIENT_ID=
# Mismo patrón que CA_SECRET_FILE/CA_CLIENT_SECRET pero para este client id.
CA_IDENTITY_ADMIN_CLIENT_SECRET=
CA_IDENTITY_ADMIN_SECRET_FILE=
CA_IDENTITY_ADMIN_USERS_PATH=
CA_IDENTITY_ADMIN_ROLES_PATH=
# Opcional (ID-001): sólo activa el catálogo de federaciones si se configura.
CA_IDENTITY_ADMIN_FEDERATIONS_PATH=

# --- SIA (Secure Infrastructure Access: políticas de acceso) ---
CA_SIA_URL=
CA_SIA_TOKEN_URL=
CA_SIA_CLIENT_ID=
CA_SIA_CLIENT_SECRET=
CA_SIA_SECRET_FILE=
CA_SIA_POLICIES_PATH=
CA_SIA_CONNECTORS_PATH=
CA_SIA_VM_INFRASTRUCTURE_PATH=
# Opcional (SIA-STRONG-001): sólo activa el catálogo de cuentas fuertes de BD si se configura.
CA_SIA_DB_STRONG_ACCOUNTS_PATH=

# --- Access space (ACCESS-001: catálogo transversal de assets) ---
CA_ACCESS_URL=
CA_ACCESS_TOKEN_URL=
CA_ACCESS_CLIENT_ID=
CA_ACCESS_CLIENT_SECRET=
CA_ACCESS_SECRET_FILE=
CA_ACCESS_ASSETS_PATH=

# --- Solo para el script de inspección manual scripts/probe_sia_endpoint.sh ---
# SIA usa un token/header específico aprobado por CyberArk; nunca reutilizar
# CA_SECRET_FILE acá. Estas variables las lee únicamente el probe, no la app
# en runtime.
SIA_PROBE_BASE_URL=
SIA_PROBE_HEADER_NAME=
SIA_PROBE_TOKEN_FILE=

# ============================================================
# CORS / origen del frontend
# ============================================================
# Origen exacto permitido para llamadas del frontend (CORS). En desarrollo es
# Vite (5173); en producción, el dominio público que sirve el frontend.
WEB_ORIGIN=http://127.0.0.1:5173
# Tamaño máximo del cuerpo de una solicitud /api (8 MiB por defecto). Debe
# cubrir el CSV JSON de inventario sin permitir cargas arbitrariamente grandes.
API_MAX_BODY_BYTES=8388608
# PENTEST-010: Swagger (/docs), ReDoc (/redoc) y /openapi.json exponen
# públicamente las ~103 operaciones de la API sin requerir sesión. Default
# `true` para no romper el desarrollo local; poner en `false` en cualquier
# ambiente donde el puerto del backend pueda ser alcanzado directamente sin
# pasar por el proxy/frontend.
EXPOSE_API_DOCS=true

# ============================================================
# Autenticación
# ============================================================
# "local": usuarios en PostgreSQL + sesiones firmadas (SessionMiddleware).
# "oidc": Google Workspace/Okta vía authlib.
# "hybrid": muestra ambos accesos: local y Okta/OIDC.
# SESSION_SECRET es obligatorio en los tres modos.
AUTH_MODE=local
# --- OIDC / Okta ---
# Requerido cuando AUTH_MODE=oidc o hybrid. El issuer debe ser la URL OIDC
# aprobada por IAM; no se inventan endpoints ni scopes fuera de este contrato.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET=
OIDC_SCOPES=openid profile email
OIDC_REDIRECT_URI=
# Token de un solo uso para crear el primer usuario admin cuando la tabla
# access_users está vacía (POST /api/auth/bootstrap, header
# X-Bootstrap-Token). Solo tiene efecto con AUTH_MODE=local. Conviene rotar
# o vaciar el valor después del primer arranque.
AUTH_BOOTSTRAP_TOKEN=
# PENTEST-001: apagado por defecto. POST /api/auth/register deja que
# quien llegue primero a la pantalla de login cree el primer administrador
# local sin ningún token, mientras access_users esté vacía (instalación
# nueva, restauración incompleta o base reinicializada). En "false" (o sin
# definir), esa ruta responde 404 y /api/auth/setup-status nunca reporta
# la ventana como disponible; el único camino para crear el primer admin
# queda POST /api/auth/bootstrap con AUTH_BOOTSTRAP_TOKEN. Activar en
# "true" solo en un entorno de desarrollo/demo donde ese self-service
# sea aceptable.
ALLOW_SELF_REGISTER_SETUP=false
# Nota: no está referenciada en el código backend actual (búsqueda en
# backend/app no encuentra usos); parece configuración heredada. No asumir
# que cambia el nombre mostrado en la UI sin verificarlo primero.
LOCAL_NAME=Administrador local

# --- OIDC (Google Workspace / Okta); solo aplica si AUTH_MODE=oidc o hybrid ---
# Claim del ID token que trae los grupos del usuario.
OIDC_GROUP_CLAIM=groups
# Mapeo JSON {"grupo-del-IdP": "rol-interno"}. Empezar con los 3 roles base
# (reader/operator/admin), no con los roles granulares por dominio
# (cyberark_*, sia_reader, identity_reader, bigid_*, netskope_*); esos se
# asignan a mano desde Acceso y Permisos hasta que haya volumen real que
# justifique un grupo de Okta dedicado. Ver docs/operations/oidc-local-test.md.
OIDC_ROLE_MAP_JSON={}
# Rol interno asignado si ningún grupo del claim matchea OIDC_ROLE_MAP_JSON.
# Nunca un rol privilegiado (ej. admin) mientras OIDC_ROLE_MAP_JSON esté
# vacío: con el mapa vacío, TODO login exitoso cae acá sin importar el grupo
# real. Vacío = sin acceso por default. El backend advierte en el log de
# arranque si detecta esta combinación riesgosa con OIDC habilitado.
OIDC_DEFAULT_ROLE=

# --- Sesión (aplica a AUTH_MODE=local y AUTH_MODE=oidc) ---
# Secreto para firmar las cookies de sesión. Obligatorio en ambos modos de
# auth. Debe contener al menos 32 bytes aleatorios; nunca commitear el real.
# Ejemplo para generarlo localmente: python -c 'import secrets; print(secrets.token_urlsafe(48))'
SESSION_SECRET=
# Duración absoluta de una sesión en segundos. Default: 8 horas.
SESSION_MAX_AGE_SECONDS=28800
# Cierre por inactividad. Default: 15 minutos.
SESSION_IDLE_TIMEOUT_SECONDS=900
# Si la cookie de sesión requiere HTTPS (flag Secure). Default en código:
# true si AUTH_MODE=oidc, false si AUTH_MODE=local. Poner siempre en true en
# producción.
SESSION_HTTPS_ONLY=false
