# Custodia / plantilla de configuración. Copiar a .env.local y completar el entorno.
# Secretos: archivos en .secrets/ referenciados por *_FILE; nunca valores inline.
# Guía: docs/operations/configuration.md. Ejecutar desde la raíz del checkout.

# ============================================================
# 01. Aplicación y HTTP
# ============================================================
# Origen exacto del frontend; orígenes adicionales separados por comas en WEB_ORIGINS.
WEB_ORIGIN=http://127.0.0.1:5173
WEB_ORIGINS=http://localhost:5173,http://127.0.0.1:5173
# Límite de solicitudes /api: 8 MiB. Desactivar la documentación API si el backend queda expuesto.
API_MAX_BODY_BYTES=8388608
EXPOSE_API_DOCS=true

# ============================================================
# 02. Base de datos y recuperación AWS
# ============================================================
# Conexión sin contraseña; DATABASE_PASSWORD_FILE contiene sólo el password.
DATABASE_URL=postgresql://user@127.0.0.1:5432/cmdb
DATABASE_PASSWORD_FILE=.secrets/database_password
# Opcional: nombre o ARN de AWS Secrets Manager; recupera AWSCURRENT sólo si hace falta.
DATABASE_SECRET_ID=
DATABASE_SECRET_REGION=

# ============================================================
# 03. Autenticación y sesión
# ============================================================
# local, oidc o hybrid. SESSION_SECRET_FILE es obligatorio en los tres modos (>= 32 bytes aleatorios).
AUTH_MODE=local
SESSION_SECRET_FILE=.secrets/session_secret
# Segundos: duración absoluta (8 h) e inactividad (15 min).
SESSION_MAX_AGE_SECONDS=28800
SESSION_IDLE_TIMEOUT_SECONDS=900
# true en producción con HTTPS. El valor explícito prevalece sobre el default del modo de auth.
SESSION_HTTPS_ONLY=false
# Mantener false: el primer administrador se crea con el token de bootstrap.
ALLOW_SELF_REGISTER_SETUP=false

# ============================================================
# 04. OIDC / Okta / Google Workspace
# ============================================================
# Requiere contrato y configuración del proveedor para AUTH_MODE=oidc o hybrid.
OIDC_ISSUER_URL=
OIDC_CLIENT_ID=
OIDC_CLIENT_SECRET_FILE=.secrets/oidc_client_secret
OIDC_SCOPES="openid profile email"
OIDC_REDIRECT_URI=
OIDC_GROUP_CLAIM=groups
# JSON de grupo IdP a rol interno. Rol por defecto vacío = sin acceso.
OIDC_ROLE_MAP_JSON={"sg_ds-hub_lectores":"reader","sg_ds-hub_operadores":"operator","sg_ds-hub_admins":"admin"}
OIDC_DEFAULT_ROLE=

# ============================================================
# 05. Automatización y primer administrador
# ============================================================
# Token técnico de escritura (X-Access-Token); no concede lectura ni login de navegador.
APP_WRITE_TOKEN_FILE=.secrets/app_write_token
APP_ACTOR_ID=local-admin
# Token de un solo uso para el primer administrador; vaciar/deshabilitar después del alta.
AUTH_BOOTSTRAP_TOKEN_FILE=.secrets/auth_bootstrap_token

# ============================================================
# 06. Sincronización
# ============================================================
# Minutos: 0 deshabilita; cualquier intervalo activo debe ser >= 5.
INGESTION_INTERVAL_MINUTES=60
# SYNC_SOURCE_INTERVALS={"netskope":30,"identity_administration":120}
# SYNC_MAX_CONCURRENT_SOURCES=3

# ============================================================
# 07. CyberArk / PAM
# ============================================================
# OAuth client_credentials de PAM. Connector Manager y Risk Management reutilizan esta configuración.
CA_IDENTITY_URL=https://example.id.cyberark.cloud
CA_PVWA_URL=https://example.privilegecloud.cyberark.cloud/PasswordVault
CA_CLIENT_ID=client-id
CA_SECRET_FILE=.secrets/ca_secret

# ============================================================
# 08. CyberArk / Identity Administration
# ============================================================
# Opcional. Configurar el contrato completo y su archivo de secreto para habilitar la fuente.
# CA_IDENTITY_ADMIN_URL=
# CA_IDENTITY_ADMIN_TOKEN_URL=
# CA_IDENTITY_ADMIN_CLIENT_ID=
# CA_IDENTITY_ADMIN_SECRET_FILE=
# CA_IDENTITY_ADMIN_USERS_PATH=
# CA_IDENTITY_ADMIN_ROLES_PATH=
# Catálogo opcional de federaciones; vacío = no consultar.
# CA_IDENTITY_ADMIN_FEDERATIONS_PATH=

# ============================================================
# 09. CyberArk / SIA
# ============================================================
# Opcional. Credenciales y endpoints propios; no se infieren de PAM.
# CA_SIA_URL=
# CA_SIA_TOKEN_URL=
# CA_SIA_CLIENT_ID=
# CA_SIA_SECRET_FILE=
# CA_SIA_POLICIES_PATH=
# CA_SIA_CONNECTORS_PATH=
# CA_SIA_VM_INFRASTRUCTURE_PATH=
# Catálogos opcionales: target sets y cuentas fuertes de BD.
# CA_SIA_TARGET_SETS_PATH=
# CA_SIA_DB_STRONG_ACCOUNTS_PATH=

# ============================================================
# 10. CyberArk / Access space
# ============================================================
# Opcional. Catálogo de assets con su contrato y credenciales explícitos.
# CA_ACCESS_URL=
# CA_ACCESS_TOKEN_URL=
# CA_ACCESS_CLIENT_ID=
# CA_ACCESS_SECRET_FILE=
# CA_ACCESS_ASSETS_PATH=

# ============================================================
# 11. Netskope / conexión e inventario
# ============================================================
# Token en archivo. Sólo se consultan los endpoints aprobados para el tenant.
NETSKOPE_URL=
NETSKOPE_API_TOKEN_FILE=.secrets/netskope_api_token
NETSKOPE_DEVICE_STATUS_PATH=/api/v2/events/datasearch/clientstatus
NETSKOPE_USERS_PATH=/api/v2/users/getusers
NETSKOPE_USER_COUNTS_PATH=/api/v2/users/counts
NETSKOPE_ALERT_PATH=/api/v2/events/datasearch/alert
# Capacidad de exportación DLP; los incidentes se capturan con la allowlist mínima aprobada.
NETSKOPE_DLP_ALERTS_PATH=/api/v2/events/dataexport/alerts/dlp
NETSKOPE_DLP_INCIDENTS_PATH=/api/v2/events/dataexport/events/incident

# ============================================================
# 12. Netskope / tareas opcionales
# ============================================================
# NETSKOPE_DEM_SITES_PATH=/api/v2/dem/config/sites
# NETSKOPE_GROUPS_PATH=/api/v2/users/getgroups
# NETSKOPE_POLICY_GROUPS_PATH=/api/v2/policy/npa/policygroups
# NETSKOPE_RBAC_PATH=/api/v2/rbac/roles
# NETSKOPE_UCI_PATH=/api/v2/incidents/users/getactiveuci
# NETSKOPE_OFFICE_EXPERIENCE_PATH=/api/v2/adem/users/getinfo
# NETSKOPE_GOLDEN_RELEASE_URL=https://docs.netskope.com/en/netskope-client-golden-release-updates

# ============================================================
# 13. Netskope / Advanced Analytics
# ============================================================
# Dejar vacío hasta verificar contrato, columnas, ventana y aprobación por hashes.
NETSKOPE_AA_SEVERITY_CONTRACT_JSON=''
NETSKOPE_AA_SEVERITY_APPROVAL_JSON=''
# NETSKOPE_AA_CHARTS_JSON='{}'

# ============================================================
# 14. Inspección manual / probe SIA
# ============================================================
# Sólo scripts/probe_sia_endpoint.sh; token/header propio, nunca reutilizar el secreto OAuth.
# SIA_PROBE_BASE_URL=
# SIA_PROBE_HEADER_NAME=
# SIA_PROBE_TOKEN_FILE=
