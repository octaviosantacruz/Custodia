{
  "name": "dshub",
  "private": true,
  "type": "module",
  "scripts": {
    "web": "concurrently -k \"npm run web:backend\" \"npm run web:frontend\"",
    "web:backend": "backend/.venv/bin/uvicorn app.main:app --app-dir backend --env-file .env.local --host 0.0.0.0 --port 8000 --reload",
    "web:frontend": "npm --prefix frontend run dev",
    "web:build": "npm --prefix frontend run build",
    "schema:baseline": "backend/.venv/bin/python scripts/build_schema_baseline.py",
    "verify": "scripts/verify.sh",
    "verify:e2e": "npm --prefix frontend run test:e2e",
    "verify:supply-chain": "scripts/verify_supply_chain.sh",
    "verify:full": "npm run verify && npm run verify:e2e && npm run verify:supply-chain"
  },
  "devDependencies": {
    "concurrently": "^10.0.4"
  },
  "engines": {
    "node": ">=24 <25"
  }
}
