# Uses the same checkout/user as deploy/custodia.service. Adjust both on a new host.
[Unit]
Description=Refresh Custodia database password and apply pending migrations
Wants=network-online.target
After=network-online.target

[Service]
Type=oneshot
User=ubuntu
WorkingDirectory=/home/ubuntu/Custodia
Environment=PATH=/usr/local/sbin:/usr/local/bin:/usr/sbin:/usr/bin:/sbin:/bin
ExecStart=/home/ubuntu/Custodia/scripts/refresh_database_password.sh
ExecStart=/home/ubuntu/Custodia/scripts/migrate.sh
TimeoutStartSec=15min
UMask=0077
NoNewPrivileges=true
